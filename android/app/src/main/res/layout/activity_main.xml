<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:background="?android:attr/colorBackground"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tab_home"
            style="@style/Tab"
            android:text="@string/tab_home" />

        <Button
            android:id="@+id/tab_settings"
            style="@style/Tab"
            android:text="@string/tab_settings" />

        <Button
            android:id="@+id/tab_log"
            style="@style/Tab"
            android:text="@string/tab_log" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Home: the state and the switch -->
        <ScrollView
            android:id="@+id/page_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/crash_banner"
                    style="@style/Banner"
                    android:text="@string/crash_banner"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true" />

                <Button
                    android:id="@+id/captcha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_captcha"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/reconnect_banner"
                    style="@style/Banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reconnect_hint" />

                    <Button
                        android:id="@+id/reconnect"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reconnect" />
                </LinearLayout>

                <Button
                    android:id="@+id/toggle"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/connect"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/summary"
                    style="@style/Label"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/import_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/import_profile" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="2dp"
                    android:text="@string/import_hint" />
            </LinearLayout>
        </ScrollView>

        <!-- Settings -->
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:descendantFocusability="beforeDescendants"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/settings_banner"
                    style="@style/Banner"
                    android:text="@string/reconnect_hint_settings"
                    android:visibility="gone" />

                <!-- Server -->
                <TextView style="@style/Section" android:layout_marginTop="0dp" android:text="@string/sec_server" />

                <TextView style="@style/Label" android:text="@string/peer" />
                <EditText
                    android:id="@+id/peer"
                    style="@style/Field"
                    android:hint="например, 203.0.113.10:56004"
                    android:inputType="textUri" />

                <TextView style="@style/Label" android:text="@string/server_key" />
                <EditText
                    android:id="@+id/server_key"
                    style="@style/Field"
                    android:fontFamily="monospace"
                    android:inputType="text|textNoSuggestions" />

                <TextView style="@style/Label" android:text="@string/private_key" />
                <EditText
                    android:id="@+id/private_key"
                    style="@style/Field"
                    android:fontFamily="monospace"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/public_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/genkey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/genkey" />

                    <Button
                        android:id="@+id/copy_pub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/copy_pub" />
                </LinearLayout>

                <TextView style="@style/Label" android:text="@string/psk" />
                <EditText
                    android:id="@+id/psk"
                    style="@style/Field"
                    android:fontFamily="monospace"
                    android:inputType="textPassword" />

                <!-- VK -->
                <TextView style="@style/Section" android:text="@string/sec_vk" />

                <TextView style="@style/Label" android:text="@string/links" />
                <EditText
                    android:id="@+id/links"
                    style="@style/Field"
                    android:gravity="top"
                    android:hint="https://vk.com/call/join/…"
                    android:inputType="textUri|textMultiLine"
                    android:minLines="2" />

                <TextView style="@style/Label" android:text="@string/conns" />
                <EditText
                    android:id="@+id/conns"
                    style="@style/Field"
                    android:inputType="number" />

                <CheckBox
                    android:id="@+id/tcp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tcp" />

                <TextView style="@style/Label" android:text="@string/fallback_dns" />
                <EditText
                    android:id="@+id/fallback_dns"
                    style="@style/Field"
                    android:inputType="textUri" />

                <!-- Tunnel -->
                <TextView style="@style/Section" android:text="@string/sec_tunnel" />

                <TextView style="@style/Label" android:text="@string/address" />
                <EditText
                    android:id="@+id/address"
                    style="@style/Field"
                    android:hint="как на роутере, например 10.66.66.2/24"
                    android:inputType="textUri" />

                <TextView style="@style/Label" android:text="@string/tunnel_dns" />
                <EditText
                    android:id="@+id/tunnel_dns"
                    style="@style/Field"
                    android:inputType="textUri" />

                <TextView style="@style/Label" android:text="@string/mtu" />
                <EditText
                    android:id="@+id/mtu"
                    style="@style/Field"
                    android:inputType="number" />

                <TextView style="@style/Label" android:text="@string/routes" />
                <EditText
                    android:id="@+id/routes"
                    style="@style/Field"
                    android:inputType="textUri|textMultiLine" />

                <CheckBox
                    android:id="@+id/bypass_lan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bypass_lan" />

                <!-- Split tunnel -->
                <TextView style="@style/Section" android:text="@string/sec_split" />

                <RadioGroup
                    android:id="@+id/split"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/split_all"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/split_all" />

                    <RadioButton
                        android:id="@+id/split_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/split_only" />

                    <RadioButton
                        android:id="@+id/split_except"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/split_except" />
                </RadioGroup>

                <Button
                    android:id="@+id/choose_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/choose_apps" />

                <TextView
                    android:id="@+id/apps_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </ScrollView>

        <!-- Log and crash reports -->
        <LinearLayout
            android:id="@+id/page_log"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp">

                <TextView style="@style/Section" android:layout_marginTop="0dp" android:text="@string/sec_crashes" />

                <TextView
                    android:id="@+id/crashes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/show_report"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/show_report" />

                    <Button
                        android:id="@+id/send_report"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/send_report" />

                    <Button
                        android:id="@+id/clear_reports"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_reports" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Section"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="0dp"
                        android:text="@string/sec_log" />

                    <TextView
                        android:id="@+id/paused"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/log_paused"
                        android:textSize="12sp"
                        android:visibility="invisible" />

                    <Button
                        android:id="@+id/copy_log"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/copy" />
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
